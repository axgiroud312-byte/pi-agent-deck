{
  "name": "pi-agent-deck",
  "version": "0.13.0",
  "description": "Pi 原生子会话的轻量多 Agent 编排、澄清问答、前后台执行与消息续接",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "multi-agent",
    "subagent"
  ],
  "files": [
    "src",
    "agents",
    "scripts/check-docs.mjs",
    "README.md",
    "DEVELOPMENT.md",
    "LICENSE",
    "docs/jev-routing.md",
    "docs/publishing.md",
    "docs/0.13.0-release.md",
    "docs/single-workspace-subagent-plan.md",
    "docs/communication-fix-2026-09-27.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "docs:check": "node scripts/check-docs.mjs",
    "check": "tsc --noEmit && node --check src/router.mjs && node --check src/persistence.mjs && node --check src/jev-service.mjs",
    "test": "node --import ./test/environment.mjs --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.87.1",
    "@earendil-works/pi-coding-agent": ">=0.87.1",
    "@earendil-works/pi-ai": ">=0.87.1",
    "@earendil-works/pi-tui": ">=0.87.1",
    "typebox": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axgiroud312-byte/pi-agent-deck.git"
  },
  "homepage": "https://github.com/axgiroud312-byte/pi-agent-deck#readme",
  "bugs": {
    "url": "https://github.com/axgiroud312-byte/pi-agent-deck/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
